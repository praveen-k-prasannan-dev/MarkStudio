<Window x:Class="MarkdownEditor.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated">

    <Border CornerRadius="8" Background="White" BorderBrush="#FFB6B6B6" BorderThickness="1" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBox x:Name="SearchBox"
                     FontSize="18"
                     Padding="12,10"
                     BorderThickness="0"
                     Background="Transparent"
                     TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <Separator Margin="0" />
            <ListBox x:Name="ResultsList"
                     MaxHeight="380"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseLeftButtonUp="ResultsList_MouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,7" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="EmptyLabel"
                       Text="No matching commands"
                       Foreground="#FF888888"
                       Padding="12,10"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
